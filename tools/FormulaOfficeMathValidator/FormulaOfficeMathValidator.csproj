<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- This exe adjudicates OMML write-backs; warnings must not accumulate silently. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Program.cs exempts two benign OpenXml validation errors by their
         English Description substrings ("leaf element"; "invalid child
         element" combined with a main:rPr path). An SDK upgrade can rewrite
         those texts and flip the exemptions back into blocking errors —
         re-verify both after any DocumentFormat.OpenXml bump. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>
</Project>
