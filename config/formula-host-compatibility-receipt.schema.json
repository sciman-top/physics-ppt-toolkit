{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://physics-ppt-toolkit.local/schema/formula-host-compatibility-receipt.schema.json",
  "title": "Physics PPT formula host compatibility receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "policy", "input", "targets", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnly", "writeBackAllowed", "inputModified"],
      "properties": {
        "readOnly": { "const": true },
        "writeBackAllowed": { "const": false },
        "inputModified": { "const": false }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "status", "version", "build", "slideCount", "opened", "exported", "artifact", "reason"],
        "properties": {
          "host": { "type": "string", "minLength": 1 },
          "status": { "enum": ["Passed", "Failed", "Unavailable", "NotEvaluated"] },
          "version": { "type": "string" },
          "build": { "type": "string" },
          "slideCount": { "type": "integer", "minimum": 0 },
          "opened": { "type": "boolean" },
          "exported": { "type": "boolean" },
          "exportMethod": { "type": "string" },
          "exportFallbackReason": { "type": "string" },
          "artifact": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
            }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
