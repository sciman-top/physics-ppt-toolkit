{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://physics-ppt-toolkit.local/schema/formula-ole-visual-adjudication.schema.json",
  "title": "Physics PPT current MathType/OLE visual adjudication proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "policy", "input", "counts", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "readOnly", "planOnly", "writeBackAllowed"],
      "properties": {
        "kind": { "const": "CurrentOleVisualAdjudicationProposal" },
        "readOnly": { "const": true },
        "planOnly": { "const": true },
        "writeBackAllowed": { "const": false }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePptx", "inventory", "cropManifest", "adjudicationCsv"],
      "properties": {
        "sourcePptx": { "$ref": "#/definitions/fileReceipt" },
        "inventory": { "$ref": "#/definitions/fileReceipt" },
        "cropManifest": { "$ref": "#/definitions/fileReceipt" },
        "adjudicationCsv": { "$ref": "#/definitions/fileReceipt" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "candidateOnly", "manualRequired", "originalKept"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "candidateOnly": { "type": "integer", "minimum": 0 },
        "manualRequired": { "type": "integer", "minimum": 0 },
        "originalKept": { "type": "integer", "minimum": 0 }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordId", "source", "crop", "proposal"],
        "properties": {
          "recordId": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fileSha256", "sourceSha256", "carrier", "slide", "shapeId", "mediaSha256"],
            "properties": {
              "fileSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
              "sourceSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
              "carrier": { "const": "MathTypeOle" },
              "slide": { "type": "integer", "minimum": 1 },
              "shapeId": { "type": "integer", "minimum": 1 },
              "mediaSha256": { "type": "array", "items": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" } }
            }
          },
          "crop": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "pageSha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
              "pageSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
            }
          },
          "proposal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "targetCarrier", "unicodeMath", "tex", "basis", "contextAssessment", "writeBackAllowed"],
            "properties": {
              "status": { "enum": ["CandidateOnly", "ManualRequired", "OriginalKept"] },
              "targetCarrier": { "enum": ["OfficeMath", "Original"] },
              "unicodeMath": { "type": "string" },
              "tex": { "type": "string" },
              "basis": { "type": "string", "minLength": 1 },
              "contextAssessment": { "type": "string", "minLength": 1 },
              "reviewer": { "type": ["string", "null"] },
              "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "writeBackAllowed": { "const": false }
            }
          }
        }
      }
    },
    "evidenceSetSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
  },
  "definitions": {
    "fileReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    }
  }
}
