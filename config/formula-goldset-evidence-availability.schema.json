{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://physics-ppt-toolkit.local/schema/formula-goldset-evidence-availability.schema.json",
  "title": "Physics PPT formula GoldSet evidence availability receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "policy", "sourceManifest", "counts", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnly", "writeBackAllowed"],
      "properties": { "readOnly": { "const": true }, "writeBackAllowed": { "const": false } }
    },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "available", "missing", "ambiguous"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "available": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "ambiguous": { "type": "integer", "minimum": 0 }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goldSetId", "groundTruthClass", "expectedSha256", "originalPath", "status", "candidateCount"],
        "properties": {
          "goldSetId": { "type": "string", "minLength": 1 },
          "groundTruthClass": { "type": "string", "minLength": 1 },
          "expectedSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "originalPath": { "type": "string", "minLength": 1 },
          "status": { "enum": ["Available", "Missing", "Ambiguous"] },
          "resolvedPath": { "type": ["string", "null"] },
          "candidateCount": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
