{
  "schemaVersion": 1,
  "fonts": {
  "chinese": "微软雅黑",
  "compactChinese": "微软雅黑 UI",
  "latin": "Arial",
  "math": "Cambria Math",
  "mathEastAsian": "宋体"
  },
  "fontSizes": {
    "title1": 46,
    "sectionTitle": 56,
    "title2": 38,
    "body": 32,
    "bodyMax": 36,
    "displayTitleMin": 56,
    "auxiliary": 28,
    "minimum": 24,
    "tableHeader": 30,
    "tableBody": 28,
    "formulaInline": 34,
    "formulaStandalone": 38,
    "formulaCore": 42,
    "footer": 20
  },
  "colors": {
    "white": "#FFFFFF",
    "black": "#000000",
    "body": "#000000",
    "darkGray": "#222222",
    "emphasisRed": "#C00000",
    "sectionTitle": "#1F4E79",
    "extensionTitle": "#9C1C1C",
    "formulaBlue": "#004C99",
    "experimentGreen": "#006B3C",
    "yellowFill": "#FFF2CC",
    "yellowBorder": "#D6A300",
    "blueFill": "#D9EAF7",
    "grayFill": "#F2F2F2",
    "videoYellow": "#FFD966",
    "videoBlue": "#4DA3FF",
    "videoRed": "#FF4D4D",
    "videoGreen": "#00B050"
  },
  "styleRules": [
    {
      "id": "STYLE.TEXT.FONT",
      "enabled": true,
      "riskLevel": "R1",
      "allowedProperties": ["FontName", "NameFarEast", "Size", "Bold", "Color"],
      "scope": "TextRange"
    },
    {
      "id": "STYLE.FORMULA.TEXT",
      "enabled": true,
      "riskLevel": "R1",
      "allowedProperties": ["FontName", "NameFarEast", "Size", "Bold", "Color", "ParagraphAlignment"],
      "scope": "FormulaText"
    },
    {
      "id": "STYLE.HIGHLIGHT.BOX_SHAPE",
      "enabled": true,
      "riskLevel": "R1",
      "allowedProperties": [
        "Fill.ForeColor",
        "Line.Visible",
        "Line.ForeColor",
        "Line.Weight",
        "AutoShapeType",
        "Adjustments"
      ],
      "scope": "HighlightBox",
      "borderWeightPt": 2.0,
      "cornerRadiusAdj": 0.1
    },
    {
      "id": "STYLE.HIGHLIGHT.TEXT_COLOR",
      "enabled": true,
      "riskLevel": "R1",
      "allowedProperties": ["Color"],
      "scope": "YellowHighlightText"
    },
    {
      "id": "STYLE.SECTION_TITLE.EMPHASIS",
      "enabled": true,
      "riskLevel": "R1",
      "allowedProperties": ["Bold", "Color"],
      "scope": "SectionTitle"
    },
    {
      "id": "STYLE.DECORATIVE.EFFECTS",
      "enabled": true,
      "riskLevel": "R1",
      "allowedProperties": ["Shadow", "Glow", "SoftEdge", "FontShadow", "FontOutline"],
      "scope": "ShapeDecoration"
    },
    {
      "id": "SLIDE.BACKGROUND",
      "enabled": false,
      "riskLevel": "R2",
      "allowedProperties": ["FollowMasterBackground", "Fill.Solid", "Fill.ForeColor.RGB"],
      "scope": "Slide"
    },
    {
      "id": "SLIDE.TRANSITION.ADVANCE_ON_CLICK",
      "enabled": true,
      "riskLevel": "R1",
      "allowedProperties": ["AdvanceOnClick"],
      "scope": "Slide"
    }
  ],
  "formulaWhitelist": [
    {
      "name": "功",
      "sourcePattern": "^W=F[∙·*×]?s$",
      "targetUnicodeMath": "W=Fs",
      "targetTex": "W=Fs",
      "note": "机械功基本公式；初中课件默认保留教材常见的隐式乘法写法。"
    },
    {
      "name": "总功",
      "sourcePattern": "^W总=F[∙·*×]?s$",
      "targetUnicodeMath": "W_总=Fs",
      "targetTex": "W_{\\text{总}}=Fs",
      "note": "总功常用式；中文角标按下标处理，保留 Fs 隐式乘法。"
    },
    {
      "name": "有用功",
      "sourcePattern": "^W有=G物h$",
      "targetUnicodeMath": "W_有=G_物h",
      "targetTex": "W_{\\text{有}}=G_{\\text{物}}h",
      "note": "有用功常用式；中文角标按下标处理，不强制插入乘点。"
    },
    {
      "name": "额外功",
      "sourcePattern": "^W额=W总-W有$",
      "targetUnicodeMath": "W_额=W_总-W_有",
      "targetTex": "W_{\\text{额}}=W_{\\text{总}}-W_{\\text{有}}",
      "note": "额外功关系式；中文角标按下标处理。"
    },
    {
      "name": "功率",
      "sourcePattern": "^P=W/t$",
      "targetUnicodeMath": "P=W/t",
      "targetTex": "P=\\frac{W}{t}",
      "note": "功率定义式，适合人工确认后转换为上下分式。"
    },
    {
      "name": "机械效率",
      "sourcePattern": "^η=W有/W总$",
      "targetUnicodeMath": "η=W_有/W_总",
      "targetTex": "\\eta=\\frac{W_{\\text{有}}}{W_{\\text{总}}}",
      "note": "机械效率常用式；中文角标按下标处理，同时保留隐式乘法等初中课件写法。"
    },
    {
      "name": "欧姆定律电流",
      "sourcePattern": "^I=U/R$",
      "targetUnicodeMath": "I=U/R",
      "targetTex": "I=\\frac{U}{R}",
      "note": "欧姆定律，适合人工确认后转换为上下分式。"
    },
    {
      "name": "欧姆定律电阻",
      "sourcePattern": "^R=U/I$",
      "targetUnicodeMath": "R=U/I",
      "targetTex": "R=\\frac{U}{I}",
      "note": "欧姆定律变形式，适合人工确认后转换为上下分式。"
    },
    {
      "name": "速度",
      "sourcePattern": "^v=s/t$",
      "targetUnicodeMath": "v=s/t",
      "targetTex": "v=\\frac{s}{t}",
      "note": "速度定义式，适合人工确认后转换为上下分式。"
    },
    {
      "name": "压强",
      "sourcePattern": "^p=F/S$",
      "targetUnicodeMath": "p=F/S",
      "targetTex": "p=\\frac{F}{S}",
      "note": "压强定义式，适合人工确认后转换为上下分式。"
    },
    {
      "name": "密度",
      "sourcePattern": "^ρ=m/V$",
      "targetUnicodeMath": "ρ=m/V",
      "targetTex": "\\rho=\\frac{m}{V}",
      "note": "密度定义式，适合人工确认后转换为上下分式。"
    },
    {
      "name": "比热容热量式",
      "sourcePattern": "^Q=cmΔt$",
      "targetUnicodeMath": "Q=cmΔt",
      "targetTex": "Q=cm\\Delta t",
      "note": "比热容基本公式；来源：13.3比热容 OLE 公式清单 idx11。"
    },
    {
      "name": "吸热公式",
      "sourcePattern": "^Q吸=cmΔt$",
      "targetUnicodeMath": "Q_吸=cmΔt",
      "targetTex": "Q_{\\text{吸}}=cm\\Delta t",
      "note": "吸热量公式，中文角标按下标处理；来源：13.3比热容 OLE 清单 idx1。"
    },
    {
      "name": "放热公式",
      "sourcePattern": "^Q放=cmΔt$",
      "targetUnicodeMath": "Q_放=cmΔt",
      "targetTex": "Q_{\\text{放}}=cm\\Delta t",
      "note": "放热量公式，中文角标按下标处理；来源：13.3比热容 OLE 清单 idx2。"
    },
    {
      "name": "燃料与水的热量关系",
      "sourcePattern": "^Q放=Q吸=cmΔt$",
      "targetUnicodeMath": "Q_放=Q_吸=cmΔt",
      "targetTex": "Q_{\\text{放}}=Q_{\\text{吸}}=cm\\Delta t",
      "note": "14.1燃料实验页的 GoldSet 候选；只有 OLE 组合同步通过视觉与结构门禁后才允许转换。"
    },
    {
      "name": "燃料放热量公式",
      "sourcePattern": "^Q放=qm$",
      "targetUnicodeMath": "Q_放=qm",
      "targetTex": "Q_{\\text{放}}=qm",
      "note": "燃料热值关系式；中文角标按下标处理，适用于 14.1 样本的审定 OLE。"
    },
    {
      "name": "燃料燃烧效率",
      "sourcePattern": "^η=Q吸/Q放$",
      "targetUnicodeMath": "η=Q_吸/Q_放",
      "targetTex": "\\eta=\\frac{Q_{\\text{吸}}}{Q_{\\text{放}}}",
      "note": "燃烧效率定义式；分母分子必须保持教材语义，适用于审定 OLE。"
    },
    {
      "name": "热机效率定义式",
      "sourcePattern": "^η=W有/Q放$",
      "targetUnicodeMath": "η=W_有/Q_放",
      "targetTex": "\\eta=\\frac{W_{\\text{有}}}{Q_{\\text{放}}}",
      "note": "热机效率定义式（有用功/燃料完全燃烧放出的热量）；来源：14.2热机 slide26 顶部主式 OLE（s26-sh3）。"
    },
    {
      "name": "气体燃料放热量公式",
      "sourcePattern": "^Q放=qV$",
      "targetUnicodeMath": "Q_放=qV",
      "targetTex": "Q_{\\text{放}}=qV",
      "note": "气体燃料放热关系式（热值 q 按体积 J/m³）；来源：14.2热机 slide26 括号组 OLE（s26-sh9）。"
    },
    {
      "name": "吸热关系括号式",
      "sourcePattern": "^\\(Q吸=cmΔt\\)$",
      "targetUnicodeMath": "(Q_吸=cmΔt)",
      "targetTex": "(Q_{\\text{吸}}=cm\\Delta t)",
      "note": "效率页括号说明式；括号属于公式内容，转换时必须保留。"
    },
    {
      "name": "放热关系括号式",
      "sourcePattern": "^\\(Q放=qm\\)$",
      "targetUnicodeMath": "(Q_放=qm)",
      "targetTex": "(Q_{\\text{放}}=qm)",
      "note": "效率页括号说明式；括号属于公式内容，转换时必须保留。"
    },
    {
      "name": "放热量符号",
      "sourcePattern": "^Q放$",
      "targetUnicodeMath": "Q_放",
      "targetTex": "Q_{\\text{放}}",
      "note": "图示中的放热量符号；仅在独立 OLE 且边界复核通过时转换。"
    },
    {
      "name": "吸热量等号片段",
      "sourcePattern": "^=Q吸$",
      "targetUnicodeMath": "=Q_吸",
      "targetTex": "=Q_{\\text{吸}}",
      "note": "14.1第6页同一条等式中的第二个 Equation.DSMT4 分段；仅在对应 GoldSet 证据中转换。"
    },
    {
      "name": "热量乘积等号片段",
      "sourcePattern": "^=cmΔt$",
      "targetUnicodeMath": "=cmΔt",
      "targetTex": "=cm\\Delta t",
      "note": "14.1第6页同一条等式中的第三个 Equation.DSMT4 分段；仅在对应 GoldSet 证据中转换。"
    },
    {
      "name": "吸热公式左半段",
      "sourcePattern": "^Q吸=$",
      "targetUnicodeMath": "Q_吸=",
      "targetTex": "Q_{\\text{吸}}=",
      "note": "吸热公式接数值代入的左半段 OLE；来源：13.3比热容 OLE 清单 idx3（保留原形状 id 以延续动画）。"
    },
    {
      "name": "乘积带等号右半段",
      "sourcePattern": "^cmΔt=$",
      "targetUnicodeMath": "cmΔt=",
      "targetTex": "cm\\Delta t=",
      "note": "吸热公式接数值代入的右半段 OLE；来源：13.3比热容 OLE 清单 idx4。"
    },
    {
      "name": "比热容定义式",
      "sourcePattern": "^c=Q/mΔt$",
      "targetUnicodeMath": "c=Q/mΔt",
      "targetTex": "c=\\frac{Q}{m\\Delta t}",
      "note": "比热容定义式（分式）；来源：13.3比热容 OLE 清单 idx9。"
    },
    {
      "name": "比热容吸热定义式",
      "sourcePattern": "^c=Q吸/mΔt$",
      "targetUnicodeMath": "c=Q_吸/mΔt",
      "targetTex": "c=\\frac{Q_{\\text{吸}}}{m\\Delta t}",
      "note": "吸热版比热容定义式（分式）；来源：13.3比热容 OLE 清单 idx15。"
    },
    {
      "name": "质量变形式",
      "sourcePattern": "^m=Q/cΔt$",
      "targetUnicodeMath": "m=Q/cΔt",
      "targetTex": "m=\\frac{Q}{c\\Delta t}",
      "note": "质量变形式（分式）；来源：13.3比热容 OLE 清单 idx10。"
    },
    {
      "name": "温差变形式",
      "sourcePattern": "^Δt=Q/cm$",
      "targetUnicodeMath": "Δt=Q/cm",
      "targetTex": "\\Delta t=\\frac{Q}{cm}",
      "note": "温差变形式（分式）；来源：13.3比热容 OLE 清单 idx12。"
    },
    {
      "name": "吸热温差式",
      "sourcePattern": "^Δt=Q吸/cm$",
      "targetUnicodeMath": "Δt=Q_吸/cm",
      "targetTex": "\\Delta t=\\frac{Q_{\\text{吸}}}{cm}",
      "note": "吸热温差式（分式）；来源：13.3比热容 OLE 清单 idx13。"
    },
    {
      "name": "放热温差式",
      "sourcePattern": "^Δt=Q放/cm$",
      "targetUnicodeMath": "Δt=Q_放/cm",
      "targetTex": "\\Delta t=\\frac{Q_{\\text{放}}}{cm}",
      "note": "放热温差式（分式）；本批 OLE 清单未命中，供文本链与后续批次复用。"
    },
    {
      "name": "四分之一",
      "sourcePattern": "^1/4$",
      "targetUnicodeMath": "1/4",
      "targetTex": "\\frac{1}{4}",
      "note": "独立数值分式；来源：13.3比热容 OLE 清单 idx14（红色）。"
    },
    {
      "name": "放热量符号带等号",
      "sourcePattern": "^Q放=$",
      "targetUnicodeMath": "Q_放=",
      "targetTex": "Q_{\\text{放}}=",
      "note": "放热量符号接等号的左半段 OLE；来源：14.1燃料 OLE 清单 slide6。"
    },
    {
      "name": "乘积式",
      "sourcePattern": "^cmΔt$",
      "targetUnicodeMath": "cmΔt",
      "targetTex": "cm\\Delta t",
      "note": "cmΔt 乘积式 OLE；来源：14.1燃料 OLE 清单 slide6。"
    },
    {
      "name": "放热代入链460J",
      "sourcePattern": "^Q放=cmΔt=0\\.46×10³J/\\(kg·℃\\)×2×10⁻³kg×500℃=460J$",
      "targetUnicodeMath": "Q_放=cmΔt=0.46×10^(3)J\\/(kg·℃)×2×10^(-3)kg×500℃=460J",
      "targetTex": "Q_{\\text{放}}=cm\\Delta t=0.46\\times10^{3}\\text{J}/(\\text{kg}\\cdot℃)\\times2\\times10^{-3}\\text{kg}\\times500℃=460\\text{J}",
      "note": "铝块放热数值代入链；来源：13.3 v17 遗留 OLE 清单 idx6（slide13 裁剪图，judge 定稿）。"
    },
    {
      "name": "温差代入链500℃",
      "sourcePattern": "^Δt=520℃[-−]20℃=500℃$",
      "targetUnicodeMath": "Δt=520℃-20℃=500℃",
      "targetTex": "\\Delta t=520℃-20℃=500℃",
      "note": "温差数值代入链；来源：13.3 v17 遗留 OLE 清单 idx7（slide13 裁剪图，judge 定稿）。"
    },
    {
      "name": "质量代入链2g",
      "sourcePattern": "^m=2g=2×10⁻³kg$",
      "targetUnicodeMath": "m=2g=2×10^(-3)kg",
      "targetTex": "m=2g=2\\times10^{-3}\\text{kg}",
      "note": "质量单位变换单位代入链；来源：13.3 v17 遗留 OLE 清单 idx8（slide13 裁剪图，judge 定稿）。"
    },
    {
      "name": "吸热代入链4.2×10⁶J",
      "sourcePattern": "^Q吸=cmΔt=4\\.2×10³J/\\(kg[·•]℃\\)×50kg×20℃=4\\.2×10⁶J$",
      "targetUnicodeMath": "Q_吸=cmΔt=4.2×10^(3)J\\/(kg·℃)×50kg×20℃=4.2×10^(6)J",
      "targetTex": "Q_{\\text{吸}}=cm\\Delta t=4.2\\times10^{3}\\text{J}/(\\text{kg}\\cdot℃)\\times50\\text{kg}\\times20℃=4.2\\times10^{6}\\text{J}",
      "note": "水吸热数值代入链；来源：13.3 v17 遗留 OLE 清单 idx16（slide29 裁剪图，judge 定稿；源图乘点为 •，canonical 归一为 ·）。"
    },
    {
      "name": "温差代入链20℃",
      "sourcePattern": "^Δt=40℃[-−]20℃=20℃$",
      "targetUnicodeMath": "Δt=40℃-20℃=20℃",
      "targetTex": "\\Delta t=40℃-20℃=20℃",
      "note": "温差数值代入链；来源：13.3 v17 遗留 OLE 清单 idx17（slide29 裁剪图，judge 定稿）。"
    }
  ],
  "rules": {
    "doNotModifyTextContent": true,
    "doNotMoveShapes": true,
    "doNotResizeShapes": true,
    "allowTextBoxWidthExpansion": false,
    "doNotModifyAnimations": true,
    "doNotModifySlideTransitions": true,
    "disableAdvanceOnClick": false,
    "doNotCropImages": true,
    "formulaTextStyleDefault": true,
    "formulaConversionDefault": false,
    "videoSlideKeywords": ["视频", "播放", "观察视频"]
  },
  "formulaProcessing": {
    "schemaVersion": 1,
    "defaultMode": "ReportOnly",
    "allowedModes": [
      "ReportOnly",
      "CandidateOnly",
      "ReviewRequired",
      "ClosedWorldUnattended",
      "ExplicitMigration"
    ],
    "defaultTargetCarrier": "OfficeMath",
    "writeBackEnabled": false,
    "imageFormulaWriteBackEnabled": false,
    "mathTypeMigrationEnabled": false,
    "ocrEnabled": false,
    "modelInferenceEnabled": false,
    "unattendedCanonicalSources": ["Whitelist", "GoldSet"],
    "unattendedRequiresPowerPointGate": true,
    "unattendedRequiresVisualGate": true
  }
}
