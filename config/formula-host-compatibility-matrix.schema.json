{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://physics-ppt-toolkit.local/schema/formula-host-compatibility-matrix.schema.json",
  "title": "Physics PPT formula host compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "policy", "decks", "hostSummary", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnly", "writeBackAllowed", "migrationExpansionAllowed"],
      "properties": {
        "readOnly": { "const": true },
        "writeBackAllowed": { "const": false },
        "migrationExpansionAllowed": { "const": false }
      }
    },
    "decks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "receiptPath", "targets"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "receiptPath": { "type": "string", "minLength": 1 },
          "targets": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "hostSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "total", "passed", "failed", "unavailable", "notEvaluated"],
        "properties": {
          "host": { "type": "string", "minLength": 1 },
          "total": { "type": "integer", "minimum": 0 },
          "passed": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "unavailable": { "type": "integer", "minimum": 0 },
          "notEvaluated": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
