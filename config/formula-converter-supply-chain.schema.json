{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://physics-ppt-toolkit.local/schema/formula-converter-supply-chain.schema.json",
  "title": "Physics PPT formula converter supply chain manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "policy", "lockEvidence", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writesPptx", "defaultConverter", "referenceConverter"],
      "properties": {
        "writesPptx": { "const": false },
        "defaultConverter": { "type": "string", "minLength": 1 },
        "referenceConverter": { "type": "string", "minLength": 1 }
      }
    },
    "lockEvidence": { "type": "object" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "role", "version", "sha256", "license", "licenseEvidence", "source", "consumer", "removal"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["Adopted", "ReferenceOnly", "FallbackOnly", "NotAdopted"] },
          "role": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
          "license": { "type": "string", "minLength": 1 },
          "licenseEvidence": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "consumer": { "type": "string", "minLength": 1 },
          "removal": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
